POSTGRES_DB=gamics
POSTGRES_USER=gamics
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_REPLICATION_PASSWORD=replace-with-a-different-long-random-password
DATABASE_WRITE_URL=postgres://gamics:replace-with-a-long-random-password@postgres:5432/gamics?sslmode=disable
DATABASE_READ_URL=postgres://gamics:replace-with-a-long-random-password@postgres-replica:5432/gamics?sslmode=disable
REDIS_PASSWORD=replace-with-a-long-random-password
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-32-character-secret

WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
GAMICS_VERSION=dev
APP_ENV=development

# Local development logs OTP codes from the API container. Production must use SMTP.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
