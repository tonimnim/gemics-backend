POSTGRES_DB=gamics
POSTGRES_USER=gamics
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_REPLICATION_PASSWORD=replace-with-a-different-long-random-password
DATABASE_WRITE_URL=postgres://gamics:replace-with-a-long-random-password@postgres:5432/gamics?sslmode=disable
DATABASE_READ_URL=postgres://gamics:replace-with-a-long-random-password@postgres-replica:5432/gamics?sslmode=disable
REDIS_PASSWORD=replace-with-a-long-random-password
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
OTP_HASH_SECRET=replace-with-a-different-32-character-secret

# Local MinIO administrator credentials. These are development-only and never
# belong in a client bundle or URL.
MINIO_ROOT_USER=gamics-local
# MinIO credentials must contain 8-40 characters.
MINIO_ROOT_PASSWORD=replace-with-minio-root-random-secret

WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
REDIS_PORT=6379
MINIO_API_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
GAMICS_VERSION=dev
APP_ENV=development
RUN_MIGRATIONS=true

DATABASE_WRITE_MAX_CONNS=8
DATABASE_READ_MAX_CONNS=16
DATABASE_MAX_REPLICA_LAG=5s
DATABASE_FALLBACK_MAX_CONCURRENCY=16
CACHE_NAMESPACE=gamics:development:v1
GAME_CATALOG_CACHE_TTL=12h
AUTH_SESSION_CACHE_TTL=30s
TRUSTED_PROXY_CIDRS=

# For Cloudflare R2, use .env.r2 and compose.r2.yaml; see docs/cloudflare-r2.md.
# The base Docker stack enables local evidence/avatar storage. The API uses the
# internal endpoint for verification; signed PUT/GET URLs use the public origin.
# Leave the public endpoint blank to derive localhost + MINIO_API_PORT. For an
# Android emulator or physical phone, follow docs/docker.md and set it explicitly.
STORAGE_MODE=s3
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_PUBLIC_ENDPOINT=
STORAGE_S3_REGION=af-south-1
STORAGE_S3_BUCKET=gamics-local
STORAGE_S3_ACCESS_KEY=gamics-api-local
# MinIO application secrets must contain 8-40 characters.
STORAGE_S3_SECRET_KEY=replace-with-separate-random-password
STORAGE_S3_SESSION_TOKEN=
STORAGE_S3_PATH_STYLE=true
STORAGE_PRESIGN_TTL=10m
STORAGE_HTTP_TIMEOUT=10s
EVIDENCE_MAX_BYTES=10485760
# Shared per-player budgets: intents per 10 minutes; declared bytes per day;
# completion and polling requests per minute. Redis is required for these.
EVIDENCE_UPLOAD_LIMIT=30
EVIDENCE_DAILY_BYTES=536870912
EVIDENCE_ACTION_LIMIT=120
# Per-player avatar budgets: upload intents per 10 minutes; declared bytes per
# day. Like the evidence budgets, these fail closed without Redis.
AVATAR_UPLOAD_LIMIT=10
AVATAR_DAILY_BYTES=67108864
# Independent worker replicas can be scaled with compose --scale evidence-worker=N.
EVIDENCE_WORKER_CONCURRENCY=2
# Transient storage faults are retried with capped backoff until the retry
# window, counted from queueing, closes. A missing object is retried until its
# signed upload URL expires plus the grace. A job whose lease keeps expiring is
# failed after the recovery limit without touching storage.
EVIDENCE_WORKER_RETRY_WINDOW=5m
EVIDENCE_WORKER_MAX_BACKOFF=30s
EVIDENCE_WORKER_UPLOAD_GRACE=2m
EVIDENCE_WORKER_MAX_LEASE_RECOVERIES=2
# Process-wide decoder memory. The worker refuses to start unless
# concurrency x 25 MiB + this budget + 64 MiB fits within its GOMEMLIMIT.
EVIDENCE_WORKER_DECODE_BUDGET_BYTES=201326592

# Players sign in with a Konami ID and password. Failed sign-ins are counted
# per Konami ID and per network for the window; registrations per network too.
LOGIN_FAILURE_WINDOW=15m
LOGIN_ACCOUNT_FAILURES=10
LOGIN_IP_FAILURES=50
REGISTRATION_WINDOW=1h
REGISTRATION_IP_LIMIT=10

# Email codes verify an address a player adds and reset forgotten passwords.
# Local development logs them from the API container. Production must use SMTP.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT=10s
SMTP_REQUIRE_TLS=false

# Daraja stays disabled until real sandbox or production credentials and a
# public HTTPS API origin are provided. Never commit those values.
MPESA_ENVIRONMENT=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_BASE_URL=
# Generate with: openssl rand -hex 24 (hex never spells a word Daraja blocks).
MPESA_CALLBACK_TOKEN=replace-with-openssl-rand-hex-24
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TIMEOUT=15s
MPESA_MAX_AMOUNT_MINOR=1000000
MPESA_USER_LIMIT=5
MPESA_PHONE_LIMIT=8
MPESA_IP_LIMIT=20
MPESA_USER_WINDOW=15m
MPESA_PHONE_WINDOW=1h
MPESA_IP_WINDOW=1h

# Inbox projection is always enabled. Expo delivery starts only when an access
# token is supplied; leave it blank locally to retain notifications without
# making outbound provider calls.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
EXPO_PUSH_TIMEOUT=10s
EXPO_RECEIPT_INITIAL_DELAY=30s
EXPO_RECEIPT_RETRY_BASE=30s
EXPO_RECEIPT_BATCH=300
EXPO_RECEIPT_MAX_ATTEMPTS=12
NOTIFICATION_POLL_INTERVAL=1s
NOTIFICATION_PROJECT_BATCH=50
NOTIFICATION_PUSH_BATCH=100
NOTIFICATION_PUSH_MAX_ATTEMPTS=8
# Active conduct strikes that block new registrations (0..20); 0 disables the ban.
RESULT_STRIKE_BAN_THRESHOLD=3
