# Cloudflare R2 overlay. Copy to .env.r2 and keep that file private.
# Use with .env.docker for the API/PostgreSQL/Redis settings.
STORAGE_MODE=r2
R2_ACCOUNT_ID=
R2_BUCKET=gamics-evidence
# S3 credentials from a bucket-scoped R2 Object Read & Write token.
# These are NOT a global Cloudflare API key or the API token bearer string.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Separate bucket-scoped R2 Object Read Only credentials for image workers.
R2_WORKER_ACCESS_KEY_ID=
R2_WORKER_SECRET_ACCESS_KEY=
# Leave empty for default jurisdiction; use eu only for an EU bucket.
R2_JURISDICTION=
