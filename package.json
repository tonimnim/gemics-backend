{
  "name": "gamics-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern apps/admin --ignore-pattern dist --ignore-pattern .next",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:lint": "npm --prefix apps/admin run lint",
    "api:dev": "go -C services/api run ./cmd/api",
    "api:test": "go -C services/api test ./...",
    "api:vet": "go -C services/api vet ./...",
    "stack:up": "docker compose --env-file .env.docker up --build",
    "stack:r2:up": "docker compose --env-file .env.docker --env-file .env.r2 -f compose.yaml -f compose.r2.yaml up --build -d",
    "stack:r2:down": "docker compose --env-file .env.docker --env-file .env.r2 -f compose.yaml -f compose.r2.yaml down",
    "stack:down": "docker compose --env-file .env.docker down"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.2",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.17",
    "postcss": "8.5.23"
  },
  "type": "module"
}
